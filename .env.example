# ─────────────────────────────────────────────────────────────
# VLuce — Template 01 · environment
# Everything is optional. With no variables set, the site runs on
# the built-in demo inventory and records enquiries in demo mode.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where inventory comes from. Leave unset: demo cars until the site is connected to Intelligence
# (from /connect), then that workspace's published stock. "demo" forces demo cars; "vandlabs" forces Intelligence.
INVENTORY_SOURCE=

# Where enquiries go. Leave unset: Intelligence for car enquiries once connected, then LEAD_WEBHOOK_URL, then demo.
# "demo" never sends anything; "webhook" skips Intelligence.
LEAD_DESTINATION=

# Generic webhook (Zapier, Make, a CRM, your own endpoint) for LEAD_DESTINATION=webhook.
# Every enquiry is POSTed as JSON.
LEAD_WEBHOOK_URL=

# ── VandLabs Automotive Intelligence (only for subscribers) ──
# Address of the Intelligence deployment, e.g. https://intelligence.vandlabs.example
VANDLABS_API_URL=
# Any random text of 24+ characters, unique to this deployment. The site derives its own read-only key from it.
# With these two set, the dealership owner opens /connect and signs in with their Intelligence email. Nothing else to copy.
WEBSITE_SECRET=
# Optional instead of /connect: a key made in Intelligence → Settings → API ("Stock" access), and the workspace id.
VANDLABS_API_KEY=
VANDLABS_TENANT_ID=
# Seconds between inventory refreshes when INVENTORY_SOURCE=vandlabs.
VANDLABS_REVALIDATE_SECONDS=300
