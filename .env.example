# ─────────────────────────────────────────────────────────────
# VLuce — Template 01 · environment
# Local development needs nothing: demo cars, and enquiries in demo mode (clearly labelled).
# A PRODUCTION deployment must have somewhere real for enquiries to go (see docs/DEPLOYMENT.md);
# without one, the forms show an error instead of pretending to send.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Inventory ──
# Leave unset: demo cars until the site is connected to Intelligence (from /connect), then that workspace's published stock.
# "demo" forces demo cars; "vandlabs" forces Intelligence.
INVENTORY_SOURCE=

# ── Enquiries ──
# auto (default): Intelligence when connected, otherwise LEAD_WEBHOOK_URL. Demo is never a silent fallback.
# "vandlabs" | "webhook" force one destination. "demo" accepts enquiries and sends nothing (the visitor is told).
LEAD_DESTINATION=
# Any HTTPS endpoint that accepts JSON (your CRM, Zapier, Make, n8n, a mail relay). Each enquiry is POSTed once per
# Idempotency-Key, with a reference the customer also sees.
LEAD_WEBHOOK_URL=
# Optional: signs each webhook (X-VLuce-Signature: sha256=<HMAC of the body>), so the receiver can verify it.
LEAD_WEBHOOK_SECRET=

# Strongly recommended in production: any PostgreSQL (Neon free tier is enough). Enables the durable enquiry queue
# (an enquiry is kept and retried if the CRM or Intelligence is down), shared rate limits across instances, and
# webhook replay protection. Not Intelligence, and not required for the site to run.
DATABASE_URL=
# Vercel Cron sends this to /api/leads/retry (daily safety net; submissions also retry queued enquiries).
CRON_SECRET=
# Staff token for /api/leads/failed (list and requeue enquiries that could not be delivered). 24+ characters.
LEADS_ADMIN_TOKEN=

# ── VandLabs Automotive Intelligence (only for subscribers) ──
# Address of the Intelligence deployment, e.g. https://vandlabs-automobile-intelligence.vercel.app
VANDLABS_API_URL=
# The website key VandLabs issues in the Intelligence admin console (dealership → Website). Shown once; keep it secret.
VANDLABS_API_KEY=
# Older setups only: websites connected by the owner's password derived their key from this. Still honoured when no key is set.
WEBSITE_SECRET=
# Workspace id, only for an Intelligence deployment older than website integration v2.
VANDLABS_TENANT_ID=
# Older Intelligence only: re-enables the owner-password form at /connect. Leave unset.
LEGACY_PASSWORD_CONNECT=
# Seconds between scheduled inventory refreshes. Changes normally arrive sooner, by signed webhook; this is the fallback.
VANDLABS_REVALIDATE_SECONDS=300
